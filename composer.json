{
  "name": "daniel-jorg-schuppelius/php-elearning-toolkit",
  "description": "Framework-freie E-Learning-Standards für PHP: SCORM 1.2/2004, xAPI, cmi5 und LTI 1.3.",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "scorm",
    "xapi",
    "cmi5",
    "lti",
    "elearning",
    "lms"
  ],
  "authors": [
    {
      "name": "Daniel Joerg Schuppelius",
      "email": "info@schuppelius.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "ELearningToolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "require": {
    "php": ">=8.2 <8.6",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "dschuppelius/php-common-toolkit": "^1.34 || ^2.0",
    "web-token/jwt-library": "^4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.27",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.3"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint --test",
    "format:fix": "vendor/bin/pint",
    "lint": "vendor/bin/phpstan analyse --memory-limit=1G",
    "qa": [
      "@format",
      "@lint",
      "@test"
    ]
  }
}
